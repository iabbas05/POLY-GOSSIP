{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gossip-bh",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/app.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gossip-bh-db",
      "database_id": "PASTE_D1_DATABASE_ID_HERE",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_APP_URL": "https://PASTE_YOUR_DOMAIN_HERE"
  }
}
