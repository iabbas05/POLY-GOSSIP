{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poly-gossip",
  "main": "index.js",
  "compatibility_date": "2026-10-12",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/app.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gossip-bh-db",
      "database_id": "288a6596-9f5a-4e00-823f-1e5014cc3e26",
      "migrations_dir": "."
    }
  ],
  "vars": {
    "PUBLIC_APP_URL": "https://gossipbh.com"
  },
  "routes": [
    {
      "pattern": "gossipbh.com",
      "custom_domain": true
    },
    {
      "pattern": "www.gossipbh.com",
      "custom_domain": true
    }
  ]
}
